+// checkUnder keeps a record at block 1 of a newer segment incarnation than the header names:
+// the round that opened the segment again landed its record but not its header. It counts
+// only if the manifest's table frees the segment under that stale header.
+func (r *Recovery) checkUnder(s uint32, img []byte, seq uint64) {
+	p, ok := r.candidate(img, 1, 0, true)
+	if !ok || p.seq <= seq || p.headerBlocks > 1 {
+		return
+	}
+	if h, err := DecodeHeader(img, Place{LogID: r.sb.LogID, Seq: p.seq, Offset: 1}, r.sb.SegmentBlocks-1, r.scratch[:0]); err == nil {
+		r.segs[s].under = foundHeader{segment: s, block: 1, lsn: h.Record.LSN, seq: p.seq}
+	}
+}
