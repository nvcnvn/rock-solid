# Picker cases: run sizes in MiB, newest first (mib), the oldest held by a running merge (held),
# and the settings a case changes: trigger, ratio (%), size-amp (%), buffer-mib, limit (0 auto),
# max-mib (the most a run may hold). Defaults: trigger 4, ratio 1, size-amp 200, buffer-mib 1,
# limit 0. Each pick prints the rule that fires and the runs [i, j) it merges, then picks again
# with them held. The cases of docs/test-scenarios.md come first, then RocksDB's universal cases
# that exercise the three rules.

# three runs
pick mib=(1, 1, 1)
----
none

# four equal runs
pick mib=(1, 1, 1, 1)
----
size amplification [0, 4)
none

# small runs above a large one
pick mib=(0.1, 0.1, 0.1, 0.1, 10)
----
size ratio [0, 4)
none

# ratio stops at 20
pick mib=(4, 4, 8, 20, 100)
----
size ratio [0, 3)
none

# ratio from the newest
pick mib=(10, 1, 1, 100)
----
size ratio [0, 3)
none

# growing tenfold
pick mib=(1, 10, 100, 1000)
----
none

# ratio starts again
pick mib=(1, 10, 9, 1000)
----
size ratio [1, 3)
none

# ten runs growing by half
pick mib=(1, 1.5, 2.25, 3.375, 5.0625, 7.59375, 11.390625, 17.0859375, 25.62890625, 38.443359375)
----
run limit [0, 3)
none

# amplification 700%
pick mib=(300, 300, 100, 100)
----
size amplification [0, 4)
none

# fixed limit 4
pick mib=(1, 10, 100, 1000, 10000) limit=4
----
run limit [0, 2)
none

# oldest three held
pick mib=(1, 1, 1, 1, 10, 20, 30) held=3
----
size ratio [0, 4)
none

# one free run above three held
pick mib=(1, 1, 1, 1) held=3
----
none

# held runs count toward the trigger
pick mib=(1, 1, 1, 1) held=2
----
size ratio [0, 2)
none

# every rule's span too large
pick mib=(1, 1, 1, 1) max-mib=3.5
----
none

# run limit's span fits
pick mib=(1, 1, 1, 1, 1) limit=3 max-mib=3
----
run limit [0, 3)
size ratio [3, 5)
none

