# Commit depth 2, both rounds in flight landed whole: a hot and a cold write written but not
# flushed recover as LSNs 2 and 3.
run depth=2
write hot 0 0 1 1
submit hot 1 0 2 2
submit cold 2 0 1 3
exec io108
exec io106
crash 67 68 69 128 129 130
recover open
index
----
submit hot 1 0 2 2: write 67+3 io106, fsync io107
submit cold 2 0 1 3: write 128+3 io108
recover open: LSNs 1-3, durable 3
index: 4 blocks, every block reads back, as the oracle expects at LSN 3
  chunk 0 block 0 v1 pool 1 at 66
  chunk 1 blocks 0-1 v2 pool 1 at 68-69
  chunk 2 block 0 v3 pool 1 at 130

# Commit depth 2, a round missing: of two hot rounds in flight the first's header does not land
# and the second lands whole. Both are dropped and the second's header is zeroed, so a shorter
# write that reuses LSN 2 is not followed, on the next open, by the old LSN 3.
run depth=2
write hot 0 0 1 1
submit hot 1 0 2 2
submit hot 2 0 1 3
exec io108
exec io106
crash 68 69 70 71
recover open
zeros 70
write hot 3 0 1 4
recover open
index
----
submit hot 1 0 2 2: write 67+3 io106, fsync io107
submit hot 2 0 1 3: write 70+2 io108
recover open: LSNs 1-1, durable 1, headers erased: 1
zeros 70: true
recover open: LSNs 1-2, durable 2
index: 2 blocks, every block reads back, as the oracle expects at LSN 2
  chunk 0 block 0 v1 pool 1 at 66
  chunk 3 block 0 v4 pool 1 at 68

# A recovery that reports the LSN before the last it replayed loses an acknowledged record.
run plant=stop-early
write hot 0 0 2 1
write hot 1 0 2 2
recover open
index
----
recover open: LSNs 1-2, durable 1
index: 4 blocks, every block reads back, oracle: recovered to LSN 1, acknowledged 2: recovery lost an acknowledged record
  chunk 0 blocks 0-1 v1 pool 1 at 66-67
  chunk 1 blocks 0-1 v2 pool 1 at 69-70

# A recovery that replays past a missing record keeps LSN 3 without LSN 2: the depth-2 case of
# a round missing, whose second round the oracle expects only with the first.
run depth=2 plant=past-gaps
write hot 0 0 1 1
submit hot 1 0 2 2
submit hot 2 0 1 3
exec io108
exec io106
crash 68 69 70 71
recover open
index
